<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <!--
      Points at the per-user secret store outside the repository
      (~/.microsoft/usersecrets/<id>/secrets.json on Linux and macOS,
      %APPDATA%\Microsoft\UserSecrets\<id>\ on Windows). The connection string
      lives there rather than in any committed file, so there is nothing to leak.
      YuruChara.Ingestion deliberately declares the *same* id so both processes
      read one store and the connection string only has to be set once.
    -->
    <UserSecretsId>5beb71d8-3b7f-4a76-820f-36b66ce42e92</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\YuruChara.Infrastructure\YuruChara.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NetTopologySuite.IO.GeoJSON4STJ" />
  </ItemGroup>

  <!-- WebApplicationFactory in the integration tests needs to see the internal
       Program class this project's top-level statements generate. -->
  <ItemGroup>
    <InternalsVisibleTo Include="YuruChara.Api.Tests" />
  </ItemGroup>

</Project>
